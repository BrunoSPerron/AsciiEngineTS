{
  "name": "ascii-game-engine-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/laser-chess/*"
  ],
  "scripts": {
    "dev": "npm run dev -w ascii-game-engine-example",
    "chess": "npm run dev -w laser-chess-legacy",
    "build": "npm run build -w ascii-game-engine",
    "pack": "npm run build -w ascii-game-engine && npm pack -w ascii-game-engine",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10"
  }
}
